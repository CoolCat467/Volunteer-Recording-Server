{% extends "return_footer.html.jinja" %}
{% block title scoped %}Select your user{% if show_create %} or create a new account{% endif %}{% endblock title %}
{% block body scoped %}
<form id="select_user" name="select_user" method="post">
  {% if records_exist %}
  <table class="user-table center">
    <thead>
      <tr>
        {% for header_element in ('First Name', 'Last Name', 'Select') %}
        <th>{{ header_element }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for user_id, user in user_records %}
      <tr>
        <td>{{ user.firstname|escape }}</td>
        <td>{{ user.lastname|escape }}</td>
        <td><button type="submit" name="user_id" value="{{ user_id }}">Select</button></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No users currently exist with this code. Press the button below to create one.</p>
  {% endif %}
  <br>
  {{ super() -}}
  <a class="submit_button" href="{{ return_link }}">Enter a different code</a>
  {% if show_create %}
  <button type="submit" name="create_user">Create new user</button>
  {% endif %}
</form>
{% endblock body %}
