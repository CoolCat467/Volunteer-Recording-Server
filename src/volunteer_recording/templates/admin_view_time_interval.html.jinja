{% extends "admin_return_signout.html.jinja" %}
{% block title scoped %}Administration View Time Interval Panel{% endblock title %}
{% block body scoped %}
<form id="view_time_interval" name="view_time_interval" method="post">
  <p>Autofill Range</p>
  {% for range_text in ('week', 'month', 'year') %}
  <button type="submit" name="autofill_range_select" value="{{ range_text }}">This {{ range_text }}</button>
  {% endfor %}
  <table>
    <tr>
      <td>
        <label for="interval_start_field">Interval Start Day</label>
        <input type="date" id="interval_start_field" name="interval_start_day" autocomplete="off" size="30" value="{{ interval_start_day }}">
      </td>
      <td>
        <label for="interval_end_field">Interval End Day</label>
        <input type="date" id="interval_end_field" name="interval_end_day" autocomplete="off" size="30" value="{{ interval_end_day }}">
      </td>
      <td>
        <button type="submit">Submit</button>
      </td>
      <td>
        <a href="{{ export_link }}" class="submit_button">Export as CSV</a>
      </td>
    </tr>
  </table>
</form>
<div class="box">
  <table class="user-table center">
    <caption>Hours Per User</caption>
    <thead>
      <tr>
        {% for header_element in ('First Name', 'Last Name', 'Hours') %}
        <th>{{ header_element }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for user, hours_fraction in time_interval_records if hours_fraction %}
      <tr>
        <td>{{ user.firstname|escape }}</td>
        <td>{{ user.lastname|escape }}</td>
        <td>{{ hours_fraction|float|round(3, 'ceil') }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <br>
  <table class="user-table center">
    <caption>Total</caption>
    <thead>
      <tr>
        {% for header_element in ('Unique Volunteers', 'Total Hours') %}
        <th>{{ header_element }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      <tr>
        {% for value in (time_interval_records|map(attribute=1)|select|list|length, time_interval_records|sum(attribute=1)|float|round(3, 'ceil')) %}
        <td>{{ value }}</td>
        {% endfor %}
      </tr>
    </tbody>
  </table>
</div>
<br>
{% for category, time_interval_records in category_user_breakdown %}
<div class="box">
  <table class="user-table center">
    <caption>Hours Per User for <code>{{ category.title|escape }}</code></caption>
    <thead>
      <tr>
        {% for header_element in ('First Name', 'Last Name', 'Hours') %}
        <th>{{ header_element }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for user, hours_fraction in time_interval_records if hours_fraction %}
      <tr>
        <td>{{ user.firstname|escape }}</td>
        <td>{{ user.lastname|escape }}</td>
        <td>{{ hours_fraction|float|round(3, 'ceil') }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <br>
  <table class="user-table center">
    <caption>Total for <code>{{ category.title|escape }}</code></caption>
    <thead>
      <tr>
        {% for header_element in ('Unique Volunteers', 'Total Hours') %}
        <th>{{ header_element }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      <tr>
        {% for value in (time_interval_records|map(attribute=1)|select|list|length, time_interval_records|sum(attribute=1)|float|round(3, 'ceil')) %}
        <td>{{ value }}</td>
        {% endfor %}
      </tr>
    </tbody>
  </table>
</div>
<br>
{% endfor %}
<br>
{{ super() -}}
<a href="{{ export_link }}" class="submit_button">Export as CSV</a>
{% endblock body %}
{% block return_text scoped %}Sign out{% endblock return_text %}
{% block return_link scoped %}/admin/signout{% endblock return_link %}
