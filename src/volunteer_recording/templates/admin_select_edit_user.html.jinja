{% extends "admin_return_signout.html.jinja" %}
{% block title scoped %}Edit Users{% endblock title %}
{% block body scoped %}
<table class="user-table center">
  <thead>
    <tr>
      {% for header_element in ('First Name', 'Last Name', 'Date of Birth', 'Code', 'Retired', 'Admin', 'Select') %}
      <th>{{ header_element }}</th>
      {% endfor %}
    </tr>
  </thead>
  <tbody>
    {% for user_id, user in user_records %}
    <tr>
      <td>{{ user.firstname|escape }}</td>
      <td>{{ user.lastname|escape }}</td>
      <td>{{ user.date_of_birth.isoformat() }}</td>
      <td>{{ "%04d"|format(user.code) }}</td>
      <td><input {% if user.retired %}checked="true" {% endif %}type="checkbox" disabled="true"></td>
      <td><input {% if user.is_admin %}checked="true" {% endif %}type="checkbox" disabled="true"></td>
      <td><a href="/admin/edit-user/{{ user_id }}" class="submit_button">Edit</a></td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<br>
{{ super() -}}
{% endblock body %}
{% block return_text scoped %}Sign out{% endblock return_text %}
{% block return_link scoped %}/admin/signout{% endblock return_link %}
