{% extends "base.html.jinja" %}
{% block title scoped %}Enter Password{% endblock title %}
{% block body scoped %}
{% if error_message %}
<i style="color: red">{{ error_message }}</i>
{% endif %}
<form id="password_prompt" name="password_prompt" method="post">
  {% block password_field scoped %}
  <label for="password">Password</label>
  <input type="password" id="password" name="password" required="true" autofocus="true">
  {% endblock password_field %}
  <br>
  <br>
  <a class="submit_button" href="/admin-login">Back to select user</a>
  <a class="submit_button" href="/">Return to main page</a>
  <button type="submit">Submit</button>
</form>
{% endblock body %}
