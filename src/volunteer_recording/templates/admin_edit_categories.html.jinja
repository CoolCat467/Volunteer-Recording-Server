{% extends "admin_return_signout.html.jinja" %}
{% block title scoped %}Select a Category to Modify{% endblock title %}
{% block body scoped %}
<form id="select_category" name="select_category" method="post">
  <table class="user-table center">
    <thead>
      <tr>
        {% for header_element in ('Category Title', 'Retired', 'Select') %}
        <th>{{ header_element }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for category_id, category in category_records %}
      <tr>
        <td>{{ category.title|escape }}</td>
        <td><code>{{ category.retired }}</code></td>
        <td><button type="submit" name="category_id" value="{{ category_id }}">Select</button></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <br>
  {{ super() -}}
  <a href="/admin/create-category" class="submit_button">Create new category</a>
</form>
{% endblock body %}
{% block return_text scoped %}Sign out{% endblock return_text %}
{% block return_link scoped %}/admin/signout{% endblock return_link %}
