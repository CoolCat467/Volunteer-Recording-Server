{% extends "return_footer.html.jinja" %}
{% block title scoped %}Success{% endblock title %}
{% block head scoped %}
<meta http-equiv="refresh" content="{{ refreshes_after|default(10) }};url={{ self.return_link() }}">
<style>
  .success_check {
    display: block;
    color: #198754;
    font-size: 5rem;
    line-height: 1;
    margin: 1rem 0;
  }
  .box {
    border: 2px solid limegreen;
  }
</style>
{% endblock head %}
{% block body scoped %}
<div class="box">
  <p>{{ message }}</p>
  <span class="success_check center" aria-label="Success">✓</span>
  <br>
  {{ super() -}}
  <hr>
  <i>This page will automatically refresh after {{ refreshes_after|default(10) }} second{% if refreshes_after|default(10) > 1 %}s{% elif refreshes_after|default(10) == 0 %}s{% endif %}.</i>
</div>
{% endblock body %}
{% block return_text scoped %}{{ return_text|default('Return to main page') }}{% endblock return_text %}
{% block return_link scoped %}{{ return_link|default('/') }}{% endblock return_link %}
