{% extends "admin_return_signout.html.jinja" %}
{% block title scoped %}{% if update_password %}Change{% else %}Set{% endif %} Password{% endblock title %}
{% block body scoped %}
<div class="box">
  <p>
    Changes from the prior screen has been saved. Please {% if update_password %}enter a new{% else %}set a{% endif %} password for this user.{% if not update_password %} Leaving this page will abort granting administrator privileges.{% endif %}
  </p>
  <form id="new_password_prompt" name="new_password_prompt" method="post">
    {% block password_field scoped %}
    <label for="new_password">Password</label>
    <input id="new_password" name="new_password" required="true" autofocus="true" minlength="12" maxlength="128" autocomplete="new-password" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*[^A-Za-z0-9\s]).{5,}" title="Use at least 5 characters, including an uppercase letter, a lowercase letter, and a special character.">
    {% endblock password_field %}
    <br>
    <br>
    {{ super() -}}
    <a href="/admin/edit-user/{{ user_id }}" class="submit_button">Back to edit user without saving</a>
    <button type="submit">Submit</button>
  </form>
</div>
{% endblock body %}
{% block return_text scoped %}Sign out{% endblock return_text %}
{% block return_link scoped %}/admin/signout{% endblock return_link %}
