{% extends "admin_return_signout.html.jinja" %}
{% block title scoped %}Edit Category{% endblock title %}
{% block body scoped %}
<form id="modify_category" name="modify_category" method="post">
  <table>
    <tr>
      <td>
        <label for="title">Title</label>
        <input id="title" name="title" value="{{ autofill_title|escape }}" required="true" size="30">
      </td>
      <td>
        <label for="retired_checkbox">Retired</label>
        <input {% if autofill_retired %}checked="true" {% endif %}type="checkbox" id="retired_checkbox" name="retired">
      </td>
    </tr>
  </table>
  <br>
  {{ super() -}}
  <a href="/admin/edit-categories" class="submit_button">Return to category list without saving</a>
  <button type="submit">{% if creating %}
  Create new category
  {% else %}
  Save changes
  {% endif %}</button>
</form>
{% endblock body %}
{% block return_text scoped %}Sign out without saving{% endblock return_text %}
{% block return_link scoped %}/admin/signout{% endblock return_link %}
{% block return_admin_panel_text scoped %}Return to admin panel without saving{% endblock return_admin_panel_text %}
